# ============================================================
# NewAPI 自动签到 - 环境变量配置模板
# 专为 https://newapi.chinahk.qzz.io 开发，仅支持账号密码认证
# 复制本文件为 .env 并按需修改；GitHub Actions 中请配置到 Secrets
# ============================================================

# 必需：账号配置（JSON 数组，支持多账号）
# url 可省略（默认 https://newapi.chinahk.qzz.io），name 为日志备注
# 单账号：
NEWAPI_ACCOUNTS=[{"login_username":"你的用户名","login_password":"你的密码","name":"账号1"}]

# 多账号：在数组中增加对象即可
# NEWAPI_ACCOUNTS=[{"login_username":"admin","login_password":"密码1","name":"账号1"},{"login_username":"a@qq.com","login_password":"密码2","name":"账号2"}]
